{
  "name": "auto-forex-trader",
  "private": true,
  "version": "2.12.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run --pool=threads",
    "test:unit": "vitest --run --pool=threads tests/unit",
    "test:integration": "vitest --run --pool=threads tests/integration",
    "test:changed": "vitest --run --pool=threads --changed",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report --host 127.0.0.1 --port 9323",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --project=chromium --update-snapshots",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.19",
    "@mui/material": "^7.3.4",
    "@mui/x-charts": "^8.25.0",
    "@mui/x-date-pickers": "^8.16.0",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/react-window": "^1.8.8",
    "axios": "^1.15.0",
    "d3-scale": "^4.0.2",
    "d3-time-format": "^4.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "form-data": "^4.0.5",
    "i18next": "^25.6.0",
    "lightweight-charts": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^16.2.3",
    "react-router-dom": "^7.9.5",
    "react-window": "^2.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.8",
    "baseline-browser-mapping": "^2.9.14",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "semver": "7.7.2"
    },
    "tldts": "7.0.18",
    "tldts-core": "7.0.18",
    "react-is": "19.2.4",
    "yaml": "2.8.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
