sequenceDiagram
    title Task Execution - Tick Stream Completion
    autonumber

    participant Runner as BacktestRunner / TradingRunner
    participant Clock as ManualClock
    participant Bus as EventBus
    participant Executor as StrategyExecutor
    participant Strategy as Strategy
    participant Publisher as StrategyPublisher
    participant Registry as TaskRegistry
    participant ContextStore
    participant Lifecycle as TaskLifecycle
    participant Observer as ObserverNotifier
    participant Profiler as TaskProfiler

    alt backtest stream exhausted
        Runner->>Clock: set(definition.end_at)
        Runner->>Bus: expire_pending_strategy_requests(task_id, definition.end_at)
        Runner->>Executor: stop(task, mode=complete)
    else live trading stream ended
        Runner->>Executor: stop(task, mode=stop)
    end
    Executor->>Registry: current_context(task.id)
    Registry->>ContextStore: current(task.id)
    ContextStore-->>Registry: context
    Registry-->>Executor: context
    Executor->>Strategy: on_stop(context)
    Strategy-->>Executor: StrategyResult(events, state?)
    Executor->>Registry: stage_context(context with result state)
    Registry->>ContextStore: stage(context)
    Executor->>Publisher: publish(stop_result)
    Executor->>Registry: save_context(context)
    Registry->>ContextStore: save(context)
    ContextStore->>Registry: get(task_id)
    opt strategy state changed during on_stop
        ContextStore->>Registry: save(task.with_strategy_state(context.state))
    end
    alt backtest
        Executor->>Lifecycle: complete_current()
        Lifecycle->>Registry: save(task.complete(clock))
        Lifecycle->>Bus: publish(TASK_COMPLETED)
    else trading
        Executor->>Lifecycle: stop_current()
        Lifecycle->>Registry: save(task.stop(clock))
        Lifecycle->>Bus: publish(TASK_STOPPED)
    end
    Runner->>Bus: clear_pending_strategy_requests(task_id, reason)
    Runner->>Observer: finished(terminal task)
    Runner-->>Profiler: terminal task
