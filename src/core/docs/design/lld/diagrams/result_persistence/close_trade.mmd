sequenceDiagram
    title Result Persistence - Record Filled CLOSE_TRADE
    autonumber

    participant Recorder as TaskResultRecorder
    participant Ledger as TradeLedger
    participant State as TradeState
    participant Writer as ResultRecorderWriter
    participant Memory as InMemoryResultStore
    participant Flusher as ResultFlushCoordinator

    Recorder->>Ledger: record_close(record)
    alt cached open state exists
        Ledger->>State: apply_close(record)
    else close arrived without open
        Ledger->>State: from_close_without_open(record)
    end
    State-->>Ledger: latest trade summary
    opt cycle_id is present
        Ledger->>Ledger: project cycle summary from current trade states
    end
    Ledger-->>Recorder: trade summary and optional cycle summary
    Recorder->>Writer: trade(summary)
    Writer->>Memory: save_trade(summary)
    Writer->>Flusher: queue_trade(summary)
    opt cycle summary returned
        Recorder->>Writer: cycle(summary)
        Writer->>Memory: save_cycle(summary)
        Writer->>Flusher: queue_cycle(summary)
    end
