sequenceDiagram
    title Task Creation - Start Live Trading
    autonumber

    actor App
    participant Manager as TaskManager
    participant Factory as TaskRunnerFactory
    participant Task as ExecutableTask
    participant Registry as TaskRegistry
    participant Launch as TaskLaunchService

    App->>Manager: start_trading(definition, data_source, strategy, broker?, profiling?)
    alt dry_run is false and broker is missing
        Manager-->>App: ValueError
    else execution dependencies are valid
        Manager->>Factory: clock_for_definition(definition)
        Factory-->>Manager: SystemClock
        Manager->>Task: from_definition(definition, clock)
        Task-->>Manager: CREATED task with empty strategy state
        Manager->>Task: start(clock)
        Task-->>Manager: RUNNING task
        Manager->>Registry: save(started task)
        Manager->>Launch: launch(started task, type=trading, dependencies)
    end
